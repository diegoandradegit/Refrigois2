# ─────────────────────────────────────────────────────────────
# Landing de camara fria — variaveis de ambiente
#
# Copie para .env (ignorado pelo git) ou cadastre no Netlify em
# Site configuration > Environment variables.
#
# Lembre-se: o Vite le estas variaveis no momento do build. Depois
# de cadastrar, e preciso um deploy novo para elas valerem.
# ─────────────────────────────────────────────────────────────

# Para onde o formulario envia o lead.
VITE_ENDPOINT_LEAD=https://mpdlwheqvggbfxkhbtqg.supabase.co/functions/v1/lead-landing

# Pixel da Meta (Facebook e Instagram Ads). Sem valor aqui, o pixel
# simplesmente nao e carregado — nenhum script de terceiro entra na
# pagina a toa. Preencha quando for anunciar na Meta.
VITE_META_PIXEL=
